# Maintainer: Aditya Shakya <adi1090x@gmail.com>

pkgname=archcraft-skeleton
pkgver=1.0
pkgrel=2
pkgdesc="Skeleton Files for Archcraft Main and Prime"
arch=('any')
url="https://github.com/archcraft-os/archcraft-skeleton"
license=('GPL3')
conflicts=('archcraft-skeleton-wayland')
options=(!strip !emptydirs)

prepare() {
	cp -af ../files/. "$srcdir"
}

package() {
	local _skeldir="$pkgdir"/etc/skel
	mkdir -p "$_skeldir"

	# Copy all skeleton files
	cp -r "$srcdir"/. "$_skeldir"
}
